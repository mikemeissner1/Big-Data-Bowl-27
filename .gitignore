# Data: never commit. Raw files live in data/raw (about 2.3 GB) and stay local.
data/

# Python / environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
